generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AccountHolder {
  id                String             @id @default(uuid())
  name              String             @unique
  financialAccounts FinancialAccount[]

  @@map("account_holder")
}

model FinancialAccountType {
  id                String             @id @default(uuid())
  name              String             @unique
  financialAccounts FinancialAccount[]

  @@map("financial_account_type")
}

model CurrencyType {
  id         String     @id @default(uuid())
  name       String     @unique
  currencies Currency[]

  @@map("currency_type")
}

model Currency {
  id                   String                  @id @default(uuid())
  currencyTypeId       String
  code                 String
  name                 String
  symbol               String
  currencyType         CurrencyType            @relation(fields: [currencyTypeId], references: [id])
  financialAccounts    FinancialAccount[]
  dollarCurrencyQuotes DollarCurrencyQuote[]

  @@unique([currencyTypeId, code])
  @@map("currency")
}

model FinancialAccount {
  id                     String              @id @default(uuid())
  accountHolderId        String
  financialAccountTypeId String
  currencyId             String
  isActive               Boolean             @default(true)

  accountHolder         AccountHolder        @relation(fields: [accountHolderId], references: [id])
  financialAccountType  FinancialAccountType @relation(fields: [financialAccountTypeId], references: [id])
  currency              Currency             @relation(fields: [currencyId], references: [id])
  movements             Movement[]

  @@map("financial_account")
}

model MovementType {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  movements Movement[]

  @@map("movement_type")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  expenses Expense[]

  @@map("category")
}

model Movement {
  id                 String       @id @default(uuid())
  financialAccountId String
  movementTypeId     String
  operationId        String?
  date               DateTime
  amount             Float

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  movementType     MovementType     @relation(fields: [movementTypeId], references: [id])
  expense          Expense?

  @@index([financialAccountId, date])
  @@index([operationId])
  @@map("movement")
}

model Expense {
  id         String @id @default(uuid())
  movementId String @unique
  name       String
  categoryId String

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("expense")
}

model BlueDollarRate {
  id        String   @id @default(uuid())
  date      DateTime @unique
  usdArsBuy Float

  @@map("blue_dollar_rate")
}

model DollarCurrencyQuote {
  id         String   @id @default(uuid())
  currencyId String
  date       DateTime
  usdValue   Float

  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([currencyId, date])
  @@map("dollar_currency_quote")
}