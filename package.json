{
  "name": "finanzas-personales",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación de finanzas personales desktop",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace=apps/frontend\" \"npm run start:dev --workspace=apps/backend\" \"npm run dev --workspace=apps/desktop\""
  },
  "engines": {
    "node": "22.12.0",
    "npm": ">=11"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.1"
  }
}